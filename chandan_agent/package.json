{
  "name": "chandan-agent-root",
  "version": "1.0.0",
  "scripts": {
    "setup": "npm install --prefix frontend && pip install -r backend/requirements.txt",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "cd backend && python -m pytest test_main.py",
    "lint": "echo 'Linting not configured yet'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
